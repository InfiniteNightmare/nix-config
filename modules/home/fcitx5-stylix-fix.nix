# Overrides the fcitx5 theme artwork generated by stylix. The fcitx5-side
# renderer bug this module used to backport fixes for is gone with
# nixpkgs fcitx5 5.1.23; stylix's template itself is still broken:
#
# - its SVGs declare width/height="30" against a 60-unit viewBox while the
#   theme margins assume 60, and fcitx5 measures margins against the
#   intrinsic pixel size — the non-corner 9-patch tiles end up zero-sized
#   and the panel centre renders transparent;
# - the artwork is a mellow-style capsule (corner radius 19 + drop shadow)
#   whose expansion margins also drive the selected-candidate box, making
#   the highlight overflow the panel.
#
# So replace the artwork with plain rounded rects (colours still from the
# stylix palette) whose curvature fits the layout margins below.
#
# Delete this module if stylix fixes its fcitx5 template geometry.
{
  config,
  lib,
  pkgs,
  ...
}:

let
  # Render inline mustache content with the stylix palette (stylix renders a
  # string `template` as mustache content directly).
  stylixSvg =
    {
      name,
      template,
    }:
    pkgs.runCommand name { } ''
      cat "${
        config.lib.stylix.colors {
          inherit template;
          extension = ".svg";
        }
      }" > "$out"
      # Unrendered placeholders mean renamed palette keys -> invisible panel.
      if grep -q '{{' "$out"; then
        echo "stylix palette placeholders did not render for ${name}; recheck or delete modules/home/fcitx5-stylix-fix.nix" >&2
        exit 1
      fi
    '';

  # Plain rounded rects with curvature that fits the layout margins below
  # (panel: inset 1.5 + radius 6; highlight: inset 3 + radius 5).
  panelSvg = stylixSvg {
    name = "panel.svg";
    template = ''
      <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60">
        <rect x="1.5" y="1.5" width="57" height="57" rx="6" style="fill:#{{base00-hex}}"/>
      </svg>
    '';
  };

  highlightSvg = stylixSvg {
    name = "highlight.svg";
    template = ''
      <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 60 60">
        <rect x="3" y="3" width="54" height="54" rx="5" style="fill:#{{base02-hex}}"/>
      </svg>
    '';
  };

  margin = v: {
    Left = lib.mkForce v;
    Right = lib.mkForce v;
    Top = lib.mkForce v;
    Bottom = lib.mkForce v;
  };
in
{
  config = lib.mkIf config.stylix.targets.fcitx5.enable {
    i18n.inputMethod.fcitx5.themes.stylix = {
      panelImage = lib.mkForce panelSvg;
      highlightImage = lib.mkForce highlightSvg;
      theme = {
        # 9-patch margins only need to cover the 7.5 units of panel
        # curvature and stay under half the smallest popup height.
        "InputPanel/Background/Margin" = margin 12;
        "Menu/Background/Margin" = margin 12;
        # Highlight margins double as the selected-box expansion; keep the
        # box inside the panel (content margin is 10 left/right).
        "InputPanel/Highlight/Margin" = margin 10;
        "Menu/Highlight/Margin" = margin 8;
        "InputPanel/ContentMargin" = {
          Left = lib.mkForce 10;
          Right = lib.mkForce 10;
          Top = lib.mkForce 8;
          Bottom = lib.mkForce 8;
        };
      };
    };
  };
}
