#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

CLEAN_SWITCH=${LIFECYCLE_CLEAN_SWITCH:-}
BOOT_CLEAN=${LIFECYCLE_BOOT_CLEAN:-}
GENERATION_SNAPSHOT=${LIFECYCLE_GENERATION_SNAPSHOT:-}
VALID_SYSTEM_A=${LIFECYCLE_VALID_SYSTEM_A:-}
VALID_SYSTEM_B=${LIFECYCLE_VALID_SYSTEM_B:-}

if [[ -z ${CLEAN_SWITCH} || -z ${BOOT_CLEAN} || -z ${GENERATION_SNAPSHOT} ]]; then
  repository_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
  CLEAN_SWITCH=${CLEAN_SWITCH:-${repository_root}/scripts/nixos-clean-switch}
  BOOT_CLEAN=${BOOT_CLEAN:-${repository_root}/scripts/nixos-boot-clean}
  GENERATION_SNAPSHOT=${GENERATION_SNAPSHOT:-${repository_root}/scripts/nixos-generation-snapshot}
fi

if [[ -z ${VALID_SYSTEM_A} || -z ${VALID_SYSTEM_B} ]]; then
  bash_executable=$(readlink -e -- "$(command -v bash)")
  jq_executable=$(readlink -e -- "$(command -v jq)")
  VALID_SYSTEM_A=$(dirname -- "$(dirname -- "${bash_executable}")")
  VALID_SYSTEM_B=$(dirname -- "$(dirname -- "${jq_executable}")")
fi

TEST_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/nixos-lifecycle-tests.XXXXXX")
trap 'rm -rf -- "${TEST_ROOT}"' EXIT

tests_run=0

fail() {
  printf 'not ok - %s\n' "$*" >&2
  exit 1
}

assert_contains() {
  local file=$1 expected=$2

  if ! grep -F -- "${expected}" "${file}" >/dev/null; then
    if [[ -r ${file} ]]; then
      sed 's/^/  | /' "${file}" >&2
    fi
    fail "${file} does not contain: ${expected}"
  fi
}

assert_not_contains() {
  local file=$1 unexpected=$2

  if grep -F -- "${unexpected}" "${file}" >/dev/null; then
    fail "${file} unexpectedly contains: ${unexpected}"
  fi
}

assert_exists() {
  [[ -e $1 || -L $1 ]] || fail "expected path to exist: $1"
}

assert_absent() {
  [[ ! -e $1 && ! -L $1 ]] || fail "expected path to be absent: $1"
}

expect_failure() {
  local output=$1
  shift

  if "$@" >"${output}" 2>&1; then
    fail "command unexpectedly succeeded: $*"
  fi
}

run_test() {
  local name=$1
  shift

  tests_run=$((tests_run + 1))
  "$@"
  printf 'ok %d - %s\n' "${tests_run}" "${name}"
}

make_executable() {
  if [[ $(head -n 1 -- "$1") == '#!/usr/bin/env bash' ]]; then
    sed -i "1c#!${BASH}" "$1"
  fi
  chmod 0755 -- "$1"
}

make_runtime_copy() {
  local source=$1 destination=$2

  cp -- "${source}" "${destination}"
  make_executable "${destination}"
}

require_exact_source_line() {
  local source=$1 expected=$2 label=$3 count

  count=$(grep -Fxc -- "${expected}" "${source}" || true)
  [[ ${count} -eq 1 ]] \
    || fail "${label} source hook matched ${count} times instead of once"
}

make_root_test_copy() {
  local source=$1 destination=$2 mode=$3

  case "${mode}" in
    clean-switch)
      require_exact_source_line \
        "${source}" \
        "if [[ \${EUID} -ne 0 ]]; then" \
        "clean-switch EUID gate"
      require_exact_source_line \
        "${source}" \
        "  local system_path=\$1 root_dir=/run/nixos-clean-switch-gcroots" \
        "clean-switch GC-root declaration"
      ;;
    generation-snapshot)
      require_exact_source_line \
        "${source}" \
        "[[ \${EUID} -eq 0 ]] || die \"run this command as root\"" \
        "generation-snapshot EUID gate"
      require_exact_source_line \
        "${source}" \
        "mount_top_level() {" \
        "generation-snapshot mount function"
      ;;
    *)
      fail "unknown test-copy mode: ${mode}"
      ;;
  esac

  awk '
    /^if \[\[ \$\{EUID\} -ne 0 \]\]; then$/ {
      print "if [[ ${LIFECYCLE_TEST_EUID:-${EUID}} -ne 0 ]]; then"
      next
    }
    /^\[\[ \$\{EUID\} -eq 0 \]\] \|\| die "run this command as root"$/ {
      print "[[ ${LIFECYCLE_TEST_EUID:-${EUID}} -eq 0 ]] || die \"run this command as root\""
      next
    }
    /local system_path=\$1 root_dir=\/run\/nixos-clean-switch-gcroots/ {
      sub("root_dir=/run/nixos-clean-switch-gcroots", "root_dir=${LIFECYCLE_TEST_GC_ROOT_DIR:-/run/nixos-clean-switch-gcroots}")
    }
    { print }
    /^mount_top_level\(\) \{$/ {
      print "  if [[ -n ${LIFECYCLE_TEST_MOUNT_DIR:-} ]]; then"
      print "    MOUNT_DIR=${LIFECYCLE_TEST_MOUNT_DIR}"
      print "    STORAGE_DIR=\"${MOUNT_DIR}/${SNAPSHOT_STORAGE_SUBVOLUME}\""
      print "    MOUNTED=0"
      print "    return 0"
      print "  fi"
    }
  ' "${source}" >"${destination}"

  case "${mode}" in
    clean-switch)
      grep -Fx "if [[ \${LIFECYCLE_TEST_EUID:-\${EUID}} -ne 0 ]]; then" "${destination}" >/dev/null \
        || fail "clean-switch test EUID hook was not injected"
      grep -F "root_dir=\${LIFECYCLE_TEST_GC_ROOT_DIR:-/run/nixos-clean-switch-gcroots}" "${destination}" >/dev/null \
        || fail "clean-switch test GC-root hook was not injected"
      ;;
    generation-snapshot)
      grep -Fx "[[ \${LIFECYCLE_TEST_EUID:-\${EUID}} -eq 0 ]] || die \"run this command as root\"" "${destination}" >/dev/null \
        || fail "generation-snapshot test EUID hook was not injected"
      grep -Fx "  if [[ -n \${LIFECYCLE_TEST_MOUNT_DIR:-} ]]; then" "${destination}" >/dev/null \
        || fail "generation-snapshot test mount hook was not injected"
      ;;
    *)
      fail "unknown test-copy mode after transformation: ${mode}"
      ;;
  esac
  make_executable "${destination}"
}

make_nix_store_mock() {
  local path=$1

  cat >"${path}" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'nix-store|%s\n' "$*" >>"${COMMAND_LOG}"
exit 0
EOF
  make_executable "${path}"
}

make_command_logger() {
  local path=$1 label=$2

  cat >"${path}" <<EOF
#!/usr/bin/env bash
set -euo pipefail
printf '${label}|%s\\n' "\$*" >>"\${COMMAND_LOG}"
EOF
  make_executable "${path}"
}

make_system() {
  local directory=$1 label=$2

  install -d -m 0755 -- "${directory}/bin"
  cat >"${directory}/bin/switch-to-configuration" <<EOF
#!/usr/bin/env bash
set -euo pipefail
printf '${label}|%s\\n' "\$*" >>"\${COMMAND_LOG}"
EOF
  make_executable "${directory}/bin/switch-to-configuration"
}

make_profile() {
  local directory=$1 generation=$2 system_path=$3

  install -d -m 0755 -- "${directory}"
  ln -s -- "${system_path}" "${directory}/system-${generation}-link"
  ln -s -- "system-${generation}-link" "${directory}/system"
}

test_clean_switch_rejects_unsafe_arguments() {
  local fixture="${TEST_ROOT}/clean-arguments" output argument

  install -d -m 0755 -- "${fixture}"
  make_root_test_copy "${CLEAN_SWITCH}" "${fixture}/nixos-clean-switch" clean-switch

  for argument in \
    --build-host=builder \
    --rollback \
    --profile-name=test \
    --flake=.#other \
    --store-path=/nix/store/example; do
    output="${fixture}/$(printf '%s' "${argument}" | tr '/=.' '____').log"
    expect_failure "${output}" env \
      LIFECYCLE_TEST_EUID=0 \
      NIXOS_CLEAN_SWITCH_LOCK_FILE="${fixture}/lock" \
      "${fixture}/nixos-clean-switch" "${argument}"
  done

  assert_contains "${fixture}/--build-host_builder.log" "remote rebuild arguments are incompatible"
  assert_contains "${fixture}/--rollback.log" "unsupported lifecycle-changing nixos-rebuild argument"
  assert_contains "${fixture}/--profile-name_test.log" "alternate specialisations/profiles are incompatible"
  assert_contains "${fixture}/--flake__#other.log" "the flake is fixed"
  assert_contains "${fixture}/--store-path__nix_store_example.log" "configuration source overrides are unsupported"
}

test_clean_switch_noop_uses_source_helpers() {
  local fixture="${TEST_ROOT}/clean-noop"
  local active="${fixture}/active-system"
  local profile_dir="${fixture}/profiles"
  local fake_bin="${fixture}/bin"

  install -d -m 0755 -- "${fake_bin}"
  make_root_test_copy "${CLEAN_SWITCH}" "${fixture}/nixos-clean-switch" clean-switch
  make_nix_store_mock "${fake_bin}/nix-store"
  make_system "${active}" active-switch
  make_profile "${profile_dir}" 10 "${active}"
  ln -s -- "${active}" "${fixture}/current-system"
  make_command_logger "${fixture}/snapshot" snapshot
  make_command_logger "${fixture}/boot-clean" boot-clean

  cat >"${fixture}/nixos-rebuild" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'rebuild|%s\n' "$*" >>"${COMMAND_LOG}"
case "$1" in
  build)
    printf '%s\n' "${TARGET_SYSTEM}"
    ;;
  *)
    exit 99
    ;;
esac
EOF
  make_executable "${fixture}/nixos-rebuild"

  env \
    PATH="${fake_bin}:${PATH}" \
    COMMAND_LOG="${fixture}/commands.log" \
    TARGET_SYSTEM="${active}" \
    LIFECYCLE_TEST_EUID=0 \
    LIFECYCLE_TEST_GC_ROOT_DIR="${fixture}/gcroots" \
    NIXOS_CLEAN_SWITCH_LOCK_FILE="${fixture}/lock" \
    SYSTEM_PROFILE="${profile_dir}/system" \
    CURRENT_SYSTEM="${fixture}/current-system" \
    NIXOS_REBUILD="${fixture}/nixos-rebuild" \
    BOOT_CLEAN="${fixture}/boot-clean" \
    GENERATION_SNAPSHOT="${fixture}/snapshot" \
    "${fixture}/nixos-clean-switch"

  assert_contains "${fixture}/commands.log" "rebuild|build --quiet --no-reexec --no-link --flake .#thinkbook"
  assert_contains "${fixture}/commands.log" "snapshot|create 10 ${active}"
  assert_contains "${fixture}/commands.log" "boot-clean|"
  assert_not_contains "${fixture}/commands.log" "rebuild|switch"
}

test_clean_switch_prefers_target_helpers() {
  local fixture="${TEST_ROOT}/clean-target-helpers"
  local active="${fixture}/active-system"
  local target="${fixture}/target-system"
  local profile_dir="${fixture}/profiles"
  local fake_bin="${fixture}/bin"

  install -d -m 0755 -- "${fake_bin}" "${target}/sw/bin"
  make_root_test_copy "${CLEAN_SWITCH}" "${fixture}/nixos-clean-switch" clean-switch
  make_nix_store_mock "${fake_bin}/nix-store"
  make_system "${active}" active-switch
  make_system "${target}" target-switch
  make_profile "${profile_dir}" 10 "${active}"
  ln -s -- "${active}" "${fixture}/current-system"
  make_command_logger "${fixture}/source-snapshot" source-snapshot
  make_command_logger "${fixture}/source-boot-clean" source-boot-clean
  make_command_logger "${target}/sw/bin/nixos-generation-snapshot" target-snapshot
  make_command_logger "${target}/sw/bin/nixos-boot-clean" target-boot-clean

  cat >"${fixture}/nixos-rebuild" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'rebuild|%s\n' "$*" >>"${COMMAND_LOG}"
case "$1" in
