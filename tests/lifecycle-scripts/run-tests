  make_executable "${path}"
}

test_boot_clean_pairs_generation_and_snapshot_prune() {
  local fixture="${TEST_ROOT}/boot-paired-prune" output
  local boot_clean_under_test="${fixture}/nixos-boot-clean"
  local profile_dir="${fixture}/profiles"
  local fake_bin="${fixture}/bin"
  local gen1="${fixture}/system-1"
  local gen2="${fixture}/system-2"
  local gen3="${fixture}/system-3"
  local gen4="${fixture}/system-4"

  install -d -m 0755 -- "${fake_bin}" "${gen1}" "${gen2}" "${gen3}" "${gen4}" "${profile_dir}"
  make_runtime_copy "${BOOT_CLEAN}" "${boot_clean_under_test}"
  make_generation_list_mock "${fake_bin}/nix-env"
  make_command_logger "${fixture}/snapshot" snapshot
  ln -s -- "${gen1}" "${profile_dir}/system-1-link"
  ln -s -- "${gen2}" "${profile_dir}/system-2-link"
  ln -s -- "${gen3}" "${profile_dir}/system-3-link"
  ln -s -- "${gen4}" "${profile_dir}/system-4-link"
  ln -s -- "system-4-link" "${profile_dir}/system"
  ln -s -- "${gen4}" "${fixture}/current-system"
  ln -s -- "${gen2}" "${fixture}/booted-system"

  output="${fixture}/output.log"
  env \
    PATH="${fake_bin}:${PATH}" \
    GENERATION_LIST=$'1 2026-01-01\n2 2026-01-02\n3 2026-01-03\n4 2026-01-04' \
