    NIXOS_CLEAN_SWITCH_LOCK_FILE="${fixture}/lock" \
    SYSTEM_PROFILE="${profile_dir}/system" \
    CURRENT_SYSTEM="${fixture}/current-system" \
    NIXOS_REBUILD="${fixture}/nixos-rebuild" \
    BOOT_CLEAN="${fixture}/source-boot-clean" \
    GENERATION_SNAPSHOT="${fixture}/source-snapshot" \
    "${fixture}/nixos-clean-switch"

  assert_contains "${fixture}/commands.log" "source-snapshot|create 10 ${active}"
  assert_contains "${fixture}/commands.log" "source-boot-clean|--for-switch"
  assert_contains "${fixture}/commands.log" "target-snapshot|create 11 ${target}"
  assert_contains "${fixture}/commands.log" "target-boot-clean|--boot-only"
  assert_not_contains "${fixture}/commands.log" "source-snapshot|create 11"
}

test_clean_switch_failure_reactivates_source() {
  local fixture="${TEST_ROOT}/clean-recovery" output
  local active="${fixture}/active-system"
  local target="${fixture}/target-system"
  local profile_dir="${fixture}/profiles"
  local fake_bin="${fixture}/bin"

  install -d -m 0755 -- "${fake_bin}"
  make_root_test_copy "${CLEAN_SWITCH}" "${fixture}/nixos-clean-switch" clean-switch
  make_nix_store_mock "${fake_bin}/nix-store"
  make_system "${active}" active-switch
  make_system "${target}" target-switch
  make_profile "${profile_dir}" 10 "${active}"
  ln -s -- "${active}" "${fixture}/current-system"
  make_command_logger "${fixture}/snapshot" snapshot
  make_command_logger "${fixture}/boot-clean" boot-clean

  cat >"${fixture}/nixos-rebuild" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'rebuild|%s\n' "$*" >>"${COMMAND_LOG}"
case "$1" in
  build)
    printf '%s\n' "${TARGET_SYSTEM}"
    ;;
  switch)
    ln -s -- "${TARGET_SYSTEM}" "${SYSTEM_PROFILE}-11-link"
    exit 1
    ;;
  *)
    exit 99
    ;;
esac
EOF
  make_executable "${fixture}/nixos-rebuild"

  cat >"${fake_bin}/nix-env" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'nix-env|%s\n' "$*" >>"${COMMAND_LOG}"
case "$1" in
  --switch-generation)
    generation=$2
    ln -sfn -- "system-${generation}-link" "${SYSTEM_PROFILE}"
    ;;
  --delete-generations)
    shift
    while (( $# > 0 )); do
      case "$1" in
        -p)
          shift 2
          ;;
        *)
          rm -f -- "${SYSTEM_PROFILE}-$1-link"
          shift
          ;;
      esac
    done
    ;;
  *)
    exit 99
    ;;
esac
EOF
  make_executable "${fake_bin}/nix-env"

  output="${fixture}/output.log"
  expect_failure "${output}" env \
    PATH="${fake_bin}:${PATH}" \
    COMMAND_LOG="${fixture}/commands.log" \
    TARGET_SYSTEM="${target}" \
    LIFECYCLE_TEST_EUID=0 \
    LIFECYCLE_TEST_GC_ROOT_DIR="${fixture}/gcroots" \
    NIXOS_CLEAN_SWITCH_LOCK_FILE="${fixture}/lock" \
    SYSTEM_PROFILE="${profile_dir}/system" \
    CURRENT_SYSTEM="${fixture}/current-system" \
    NIXOS_REBUILD="${fixture}/nixos-rebuild" \
    BOOT_CLEAN="${fixture}/boot-clean" \
    GENERATION_SNAPSHOT="${fixture}/snapshot" \
    "${fixture}/nixos-clean-switch"

  assert_contains "${output}" "target switch failed; generation 10 was reactivated"
  assert_contains "${fixture}/commands.log" "nix-env|--switch-generation 10 -p ${profile_dir}/system"
  assert_contains "${fixture}/commands.log" "active-switch|switch"
  assert_contains "${fixture}/commands.log" "nix-env|--delete-generations -p ${profile_dir}/system 11"
  assert_contains "${fixture}/commands.log" "active-switch|boot"
  assert_absent "${profile_dir}/system-11-link"
  [[ $(readlink -e -- "${profile_dir}/system") == "${active}" ]] \
    || fail "source system profile was not restored"
}

