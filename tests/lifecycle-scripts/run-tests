test_snapshot_prunes_orphan_as_a_pair() {
  local fixture="${TEST_ROOT}/snapshot-paired-prune"
  local storage profile retained_set orphan_set retained_hash orphan_hash

  prepare_snapshot_fixture "${fixture}"
  storage="${fixture}/top/@nixos-snapshots"
  profile="${fixture}/profiles/system"
  retained_hash=$(store_hash "${VALID_SYSTEM_A}")
  orphan_hash=$(store_hash "${VALID_SYSTEM_B}")
  retained_set="${storage}/g3-${retained_hash}"
  orphan_set="${storage}/g2-${orphan_hash}"

  ln -s -- "${VALID_SYSTEM_A}" "${profile}-3-link"
  ln -s -- "system-3-link" "${profile}"
  write_manifest "${retained_set}" 3 "${VALID_SYSTEM_A}"
  write_manifest "${orphan_set}" 2 "${VALID_SYSTEM_B}"

  env \
    PATH="${fixture}/bin:${PATH}" \
    BTRFS_LOG="${fixture}/btrfs.log" \
    LIFECYCLE_TEST_EUID=0 \
    LIFECYCLE_TEST_MOUNT_DIR="${fixture}/top" \
    SNAPSHOT_LOCK_FILE="${fixture}/lock" \
    SYSTEM_PROFILE="${profile}" \
    "${fixture}/nixos-generation-snapshot" prune

  assert_exists "${retained_set}/manifest.json"
  assert_exists "${retained_set}/root"
  assert_exists "${retained_set}/home"
  assert_absent "${orphan_set}"
  assert_contains "${fixture}/btrfs.log" "delete|${orphan_set}/root"
  assert_contains "${fixture}/btrfs.log" "delete|${orphan_set}/home"
  assert_not_contains "${fixture}/btrfs.log" "${retained_set}"
  [[ $(wc -l <"${fixture}/btrfs.log") -eq 2 ]] \
    || fail "orphan pruning did not delete exactly the paired root/home members"
}

test_snapshot_retains_invalid_manifest() {
  local fixture="${TEST_ROOT}/snapshot-invalid-manifest" output
  local storage profile invalid_set invalid_hash

  prepare_snapshot_fixture "${fixture}"
  storage="${fixture}/top/@nixos-snapshots"
  profile="${fixture}/profiles/system"
  invalid_hash=$(store_hash "${VALID_SYSTEM_B}")
  invalid_set="${storage}/g2-${invalid_hash}"

  ln -s -- "${VALID_SYSTEM_A}" "${profile}-3-link"
  ln -s -- "system-3-link" "${profile}"
  install -d -m 0700 -- "${invalid_set}/root" "${invalid_set}/home"
  printf '{}\n' >"${invalid_set}/manifest.json"

  output="${fixture}/output.log"
  expect_failure "${output}" env \
    PATH="${fixture}/bin:${PATH}" \
    BTRFS_LOG="${fixture}/btrfs.log" \
    LIFECYCLE_TEST_EUID=0 \
    LIFECYCLE_TEST_MOUNT_DIR="${fixture}/top" \
    SNAPSHOT_LOCK_FILE="${fixture}/lock" \
    SYSTEM_PROFILE="${profile}" \
    "${fixture}/nixos-generation-snapshot" prune

  assert_contains "${output}" "leaving snapshot with failed validation in place"
  assert_exists "${invalid_set}/manifest.json"
  [[ ! -e ${fixture}/btrfs.log ]] || [[ ! -s ${fixture}/btrfs.log ]] \
    || fail "invalid manifest caused a Btrfs delete attempt"
}

